{
  "seed": 42,
  "output_dir": "results/lstm_baseline",
  "data": {
    "data_dir": "data/sketchrnn",
    "categories": ["cat", "apple", "bicycle"],
    "train_per_class": 5000,
    "val_per_class": 500,
    "test_per_class": 500,
    "max_seq_len": 250,
    "stroke_format": "stroke3",
    "batch_size": 128,
    "num_workers": 0
  },
  "model": {
    "encoder": "lstm",
    "hidden_dim": 256,
    "num_layers": 1,
    "bidirectional": true,
    "dropout": 0.0,
    "pooling": "last",
    "embedding_dim": null
  },
  "train": {
    "epochs": 10,
    "lr": 0.001,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "device": "auto"
  },
  "_comment": "Starting defaults, not tuned. TODO: agree on categories, subset sizes and hyperparameters as a team."
}
