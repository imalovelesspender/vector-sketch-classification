{
  "seed": 42,
  "output_dir": "results/lstm_baseline",
  "data": {
    "data_dir": "data/sketchrnn",
    "categories": [
      "cat",
      "apple",
      "bicycle"
    ],
    "train_per_class": 5000,
    "val_per_class": 500,
    "test_per_class": 500,
    "max_seq_len": 250,
    "stroke_format": "stroke3",
    "batch_size": 128,
    "num_workers": 0,
    "data_format": "processed",
    "normalize": false,
    "representation": "point_based"
  },
  "model": {
    "encoder": "lstm",
    "hidden_dim": 256,
    "num_layers": 1,
    "bidirectional": true,
    "dropout": 0.0,
    "pooling": "last",
    "embedding_dim": null,
    "centred_xy": true
  },
  "train": {
    "epochs": 10,
    "lr": 0.001,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "device": "auto"
  },
  "_comment": "Control between lstm_baseline and stroke_embed: the baseline BiLSTM over points, with centred absolute (cx, cy) appended to each point (Sihui's add_centered_coordinates; input 3 -> 5). Same data/split/epochs as the other two."
}